{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pinpoint chart values",
  "description": "Type checks for chart-owned configuration. Dependency and custom application settings remain extensible.",
  "type": "object",
  "definitions": {
    "disruptionBudget": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(100|[1-9]?[0-9])%$"
        }
      ]
    },
    "application": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "topologySpreadWhenUnsatisfiable": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "$ref": "#/definitions/disruptionBudget"
            },
            "maxUnavailable": {
              "$ref": "#/definitions/disruptionBudget"
            }
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "pinpointVersion": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "metric": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "hbase": {
          "type": "object",
          "properties": {
            "clientPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "datasource": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pool": {
              "type": "object",
              "properties": {
                "maximumPoolSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimumIdle": {
                  "type": "integer",
                  "minimum": 0
                },
                "connectionTimeout": {
                  "type": "integer",
                  "minimum": 250
                }
              }
            }
          }
        },
        "kafka": {
          "type": "object",
          "properties": {
            "createTopics": {
              "type": "boolean"
            },
            "manageExternalTopics": {
              "type": "boolean"
            },
            "topicReplicationFactor": {
              "type": "integer",
              "minimum": 1
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "partitions"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,249}$"
                  },
                  "partitions": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "pinot": {
          "type": "object",
          "properties": {
            "createTables": {
              "type": "boolean"
            },
            "manageExternalTables": {
              "type": "boolean"
            },
            "tableReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "imageRegistry": {
          "type": "string"
        },
        "waitImage": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "initSecurityContext": {
          "type": "object"
        }
      }
    },
    "web": {
      "allOf": [
        {
          "$ref": "#/definitions/application"
        },
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "sendUsage": {
                  "type": "boolean"
                }
              }
            },
            "adminApi": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "passwordSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "httpRoute": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "parentRefs": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "hostnames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          }
        }
      ]
    },
    "collector": {
      "allOf": [
        {
          "$ref": "#/definitions/application"
        },
        {
          "type": "object",
          "properties": {
            "service": {
              "type": "object",
              "properties": {
                "ports": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "externalService": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^$|^[a-z]([-a-z0-9]*[a-z0-9])?$"
                },
                "type": {
                  "enum": [
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "externalTrafficPolicy": {
                  "enum": [
                    "Cluster",
                    "Local"
                  ]
                },
                "nodePorts": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "grpcAgent": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "grpcStat": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "grpcSpan": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                },
                "loadBalancerSourceRanges": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalEgress": {
          "type": "array"
        },
        "assetDownloadEgress": {
          "type": "array"
        }
      }
    },
    "hbase": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "zookeeper": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "kafka": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "pinot": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "quickstart": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "telegraf": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostGroupName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "description": "Removed in chart 3.1.5; agent.enabled=true fails with migration guidance.",
      "type": "object"
    },
    "batch": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "sendUsage": {
              "type": "boolean"
            }
          }
        },
        "mail": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "smtpAuth": {
              "type": "boolean"
            },
            "starttls": {
              "type": "boolean"
            },
            "starttlsRequired": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "flink": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
